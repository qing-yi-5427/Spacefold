{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Spacefold",
  "version": "0.1.2",
  "identifier": "com.spacefold.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{
      "label": "main",
      "title": "间隙 Spacefold",
      "width": 1026,
      "height": 760,
      "minWidth": 320,
      "minHeight": 480,
      "resizable": true,
      "decorations": false,
      "backgroundColor": "#FFFFFF"
    }],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost data:; connect-src ipc: http://ipc.localhost 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "shortDescription": "离线磁盘空间分析与文件管理",
    "category": "Utility",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true },
      "nsis": { "languages": ["SimpChinese"] }
    }
  }
}
